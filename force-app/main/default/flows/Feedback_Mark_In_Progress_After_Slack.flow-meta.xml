<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>SMOKE TEST / INTENTIONAL BUG: After SlackMessageTs__c is set, tries to move Status to &quot;In-Progress&quot; (invalid picklist). Valid value is &quot;In Progress&quot;. Use this to verify Claude can diagnose the Flow fault from a Feedback item. Deactivate or fix after the demo.</description>
    <environments>Default</environments>
    <interviewLabel>Feedback Mark In Progress After Slack {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Feedback Mark In Progress After Slack</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <recordUpdates>
        <name>Set_Status_In_Progress_INTENTIONAL_BUG</name>
        <label>Set Status In Progress (INTENTIONAL BUG)</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <!-- INTENTIONAL BUG: valid picklist value is "In Progress" (space), not "In-Progress" -->
            <value>
                <stringValue>In-Progress</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Status_In_Progress_INTENTIONAL_BUG</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SlackMessageTs__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Feedback__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
</Flow>
