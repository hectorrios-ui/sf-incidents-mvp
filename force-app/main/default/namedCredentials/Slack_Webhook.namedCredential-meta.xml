<?xml version="1.0" encoding="UTF-8"?>
<!--
    SHELL — no secret included.
    After deploy: Setup → Named Credentials → Slack Webhook → Edit
    → paste the Slack Incoming Webhook URL into the Endpoint field and save.
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Slack_Webhook</fullName>
    <label>Slack Webhook</label>
    <allowMergeFieldsInBody>true</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <endpoint>https://hooks.slack.com/services/REPLACE_ME</endpoint>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <principalType>Anonymous</principalType>
    <protocol>NoAuthentication</protocol>
</NamedCredential>
